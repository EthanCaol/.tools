# Python 虚拟环境(体积最大的一块,qwen-typing 的 .venv 约 3.4 GB)
.venv/
venv/
env/
__pycache__/
*.py[cod]

# 运行期产物:服务日志、听写日志、PID 文件
logs/
*.log
*.pid

# 模型权重与下载缓存
models/
.cache/

# 静态 KV cache 预热用的语音。这是 tools/生成预热语音.py 的生成产物,不是源码,
# 所以不入库;server.py 启动时发现文件缺失会自己再生成一份。
qwen-typing/tools/预热.wav

# 编辑器与系统生成的文件
.vscode/
.idea/
Thumbs.db
desktop.ini
